# AutoFi configuration. Copy to .env and fill in. Only DEV_PRIVATE_KEY and a
# routing source (REWARD_ROUTER_CONTRACT_ID or DEFAULT_ANCHOR) are required.

# --- Network -------------------------------------------------------------
# "testnet" or "mainnet". URLs default to SDF endpoints for the network.
STELLAR_NETWORK=testnet
# HORIZON_URL=https://horizon-testnet.stellar.org
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org   # required on mainnet if a contract is set

# --- Wallet (required) ---------------------------------------------------
DEV_PRIVATE_KEY=
# Optional; if set it must match DEV_PRIVATE_KEY.
# DEV_PUBLIC_KEY=

# --- Routing preferences (set at least one) ------------------------------
# Deployed reward_router contract (C...). Per-developer split rules live here.
# REWARD_ROUTER_CONTRACT_ID=
# Fallback when there's no contract or no on-chain prefs for a developer.
# On testnet, SRT (Stellar's reference anchor) is always enabled.
DEFAULT_ANCHOR=SRT
DEFAULT_OFF_RAMP_PCT=70

# --- Anchors -------------------------------------------------------------
# USDC is enabled automatically. NGNX/GBPT are enabled once an issuer is set.
# NGNX_ISSUER=
# NGNX_HOME_DOMAIN=ngnx.io
# GBPT_ISSUER=
# GBPT_HOME_DOMAIN=poundtoken.io
# USDC_HOME_DOMAIN=circle.com

# --- Reward detection ----------------------------------------------------
# Assets treated as rewards: XLM, USDC, or CODE:ISSUER, comma-separated.
REWARD_ASSETS=USDC,XLM
MIN_REWARD_AMOUNT=1
# Known payer accounts (comma-separated G... keys) used to tag the source.
# DRIPS_SENDERS=
# BOUNTY_SENDERS=
# Only process payments from the senders above.
REQUIRE_KNOWN_SENDER=false
# Horizon paging cursor to start from on first run ("now" skips history).
START_CURSOR=now

# --- Swap ----------------------------------------------------------------
# Slippage tolerance in basis points (200 = 2%). SLIPPAGE_TOLERANCE_PCT also works.
SLIPPAGE_BPS=200
MAX_FEE_STROOPS=100000

# --- SEP-24 withdrawals --------------------------------------------------
SEP24_ENABLED=true
# Automatically send the anchor asset once the anchor is ready for it.
SEP24_AUTO_SEND=true
SEP24_POLL_INTERVAL_MS=10000
SEP24_TIMEOUT_MS=86400000

# --- HTTP server ---------------------------------------------------------
HTTP_PORT=8080
# Verifies X-Hub-Signature-256 on POST /webhooks/github.
# GITHUB_WEBHOOK_SECRET=
# Bearer token for GET /rewards and POST /rewards/:id/withdraw.
# Required on mainnet (24+ chars, e.g. `openssl rand -hex 24`). On testnet, leave
# unset only when the port isn't exposed — those routes are open without it.
# ADMIN_TOKEN=
# Allow the web app on this origin to call the API (enables CORS).
# CORS_ORIGIN=https://stellarflow-lab.github.io

# --- Misc ----------------------------------------------------------------
LISTENER_RATE_LIMIT_CAPACITY=5
LISTENER_RATE_LIMIT_REFILL=0.5
STATE_FILE=.autofi-state.json
# Simulate everything without submitting transactions.
DRY_RUN=true
# debug | info | warn | error
LOG_LEVEL=info

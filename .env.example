# Stellar network: "testnet" or "mainnet"
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Developer Stellar keypair
DEV_PUBLIC_KEY=G...YOUR_PUBLIC_KEY
DEV_PRIVATE_KEY=S...YOUR_SECRET_KEY

# Anchor issuer addresses
NGNX_ISSUER=G...NGNX_ISSUER_ADDRESS
GBPT_ISSUER=G...GBPT_ISSUER_ADDRESS

# Soroban RPC
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
REWARD_ROUTER_CONTRACT_ID=C...CONTRACT_ADDRESS

# Slippage tolerance for path payments (default: 1%)
SLIPPAGE_TOLERANCE_PCT=1

# GitHub webhook (optional)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Debug logging (optional)
DEBUG=false

# Rate limiting (optional)
LISTENER_RATE_LIMIT_CAPACITY=5
LISTENER_RATE_LIMIT_REFILL=0.5

# SEP-24 (optional)
SEP24_POLL_INTERVAL_MS=5000

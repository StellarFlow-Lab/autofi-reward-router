{
  "name": "autofi-reward-router",
  "version": "0.2.0",
  "description": "Automatically off-ramps developer rewards (Drips Wave, GitHub bounties) to local fiat via the Stellar DEX, Soroban preferences and SEP-24 anchors",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:debug": "LOG_LEVEL=debug ts-node src/index.ts",
    "dry-run": "DRY_RUN=true ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "contract:build": "cd contracts/reward_router && stellar contract build",
    "contract:test": "cd contracts/reward_router && cargo test"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/**/__tests__/**", "!src/index.ts"]
  }
}
